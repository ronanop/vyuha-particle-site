PORT=4000
# Bind loopback by default. Use 0.0.0.0 only behind a reverse proxy / in containers.
HOST=127.0.0.1

ELEVENLABS_API_KEY=your_elevenlabs_api_key
ELEVENLABS_AGENT_ID=your_elevenlabs_agent_id

# Required shared secret for GET /api/signed-url (Authorization: Bearer <secret> or X-Api-Key)
SIGNED_URL_SECRET=generate_a_long_random_secret

# Comma-separated browser origins allowed to call this API
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
